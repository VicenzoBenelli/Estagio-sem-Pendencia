# Valores públicos para --dart-define. Nunca coloque service_role ou segredos aqui.
# Para desenvolvimento Web ou dispositivo Android com `adb reverse tcp:54321 tcp:54321`:
# SUPABASE_URL=http://127.0.0.1:54321
# Para emulador Android (host Windows/macOS/Linux):
# SUPABASE_URL=http://10.0.2.2:54321
# Obtenha a chave pública local com `npx supabase status` (PUBLISHABLE_KEY ou ANON_KEY).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=obter-via-npx-supabase-status
